# Google Safe Browsing API Key (optional)
# Get a key from Google Cloud Console with Safe Browsing API v4 enabled
GOOGLE_SAFE_BROWSING_API_KEY= AIzaSyCU4OOCM5lVeu1Sa7kaZQ_kk73uWwou1p4

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate limiting for /api/scan (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=60

# Frontend API base URL (set to the FastAPI backend URL in production)
# Leave blank for local dev (Next.js rewrites handle proxying)
NEXT_PUBLIC_API_URL=
