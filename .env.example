# Google Safe Browsing API Key (optional)
# Get a key from Google Cloud Console with Safe Browsing API v4 enabled
GOOGLE_SAFE_BROWSING_API_KEY= AIzaSyCU4OOCM5lVeu1Sa7kaZQ_kk73uWwou1p4

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate limiting for /api/scan (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=60

# Frontend API base URL (optional - only set if calling FastAPI directly from browser)
# Leave blank for local dev and standard same-origin proxying
NEXT_PUBLIC_API_URL=

# Backend URL for Next.js API proxy to FastAPI
# Leave blank for local dev (defaults to http://127.0.0.1:8000)
# In production, set to your deployed FastAPI backend URL (e.g. https://your-backend.onrender.com)
BACKEND_URL=

# Isolated browser screenshot capture service (optional - defaults to https://api.microlink.io)
SCREENSHOT_SERVICE_URL=https://api.microlink.io

# In-memory preview response cache TTL in seconds (optional - defaults to 600)
PREVIEW_CACHE_TTL_SECONDS=600
